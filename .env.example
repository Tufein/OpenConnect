# Copy to .env and adjust. Everything is optional: the defaults run offline with demo data.

# --- Storage and server
OPENCONNECT_DB=data/openconnect.db
OPENCONNECT_HOST=127.0.0.1
OPENCONNECT_PORT=8000
# Public URL; used for the OAuth redirect URI and the Host allow-list
OPENCONNECT_BASE_URL=http://localhost:8000
# Extra Host headers to accept, comma separated (e.g. a LAN name when serving on a NAS)
# OPENCONNECT_ALLOWED_HOSTS=nas.local

# --- Garmin: "mock" (offline demo data) or "live" (Garmin Connect Developer API)
OPENCONNECT_GARMIN_MODE=mock
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=
# Shared secret for the push webhook: POST /api/garmin/webhook?token=...
# OPENCONNECT_WEBHOOK_TOKEN=
# Override the Garmin endpoints if Garmin changes them
# GARMIN_AUTHORIZE_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://connectapi.garmin.com/di-oauth2-service/oauth/token
# GARMIN_API_BASE_URL=https://apis.garmin.com

# --- AI reports: "auto" (Claude if ANTHROPIC_API_KEY is set, else offline template)
OPENCONNECT_AI_PROVIDER=auto
# ANTHROPIC_API_KEY=
OPENCONNECT_AI_MODEL=claude-opus-5-5
OPENCONNECT_AI_EFFORT=medium
# Report language: en or nl (the offline template supports both; Claude supports many)
OPENCONNECT_LANGUAGE=en
